import streamlit as st
from openai import OpenAI

st.set_page_config(page_title="CyberSafe AI")

st.title("🛡️ CyberSafe AI")
st.write("Your AI Cybersecurity Assistant")

client = OpenAI(api_key="YOUR_API_KEY")

question = st.text_input(
    "Ask anything about cybersecurity:"
)

if st.button("Ask AI"):
    if question:
        with st.spinner("Thinking..."):
            response = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[
                    {
                        "role": "system",
                        "content": "You are CyberSafe AI. Explain cybersecurity, phishing, password safety, online scams and internet security in simple language."
                    },
                    {
                        "role": "user",
                        "content": question
                    }
                ]
            )

            st.subheader("AI Response")
            st.write(response.choices[0].message.content)
